# 운영 서버용 설정 예시. 서버에서 이 파일을 .env 로 복사해 채운다.
# .env 는 서버에만 두고 git 에 올리지 않는다 (.gitignore 에 이미 있음). 값 앞뒤에 따옴표나 공백을 넣지 않는다.

# --- 도메인 ---
# 사용자가 접속하는 도메인 (DNS 가 이 서버를 가리켜야 HTTPS 인증서가 자동으로 발급된다)
DOMAIN=bread.example.com
# 같은 도메인을 https:// 로. 소셜 로그인 리다이렉트 주소와 메일 링크의 기준이 된다.
APP_BASE_URL=https://bread.example.com

# --- DB ---
DB_NAME=bigbread
DB_USERNAME=bigbread
# 길고 무작위인 값 (예: openssl rand -base64 24). 개발용 기본값이면 서버가 시작하지 않는다.
DB_PASSWORD=

# --- 지도 / 소셜 로그인 ---
# 브라우저에 공개되는 키 (카카오 개발자 콘솔에서 이 도메인을 웹 플랫폼에 등록해야 보호된다)
KAKAO_JS_KEY=
# 서버 전용 키 (카카오 로컬 검색, 소셜 로그인). 절대 공개하지 않는다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 사진 저장소 ---
# s3(권장): Cloudflare R2, AWS S3 등 S3 호환 저장소 / local: 서버 디스크 (서버를 옮기면 사진도 옮겨야 한다)
# 처음 시험할 때(R2/S3 없이)는 PHOTO_STORAGE=local 로 두면 서버 디스크(Docker 볼륨)에 저장한다.
PHOTO_STORAGE=s3
# R2 예: https://<계정ID>.r2.cloudflarestorage.com  (AWS S3 면 비워 둔다)
PHOTO_S3_ENDPOINT=
# R2 는 auto, AWS S3 는 ap-northeast-2 등
PHOTO_S3_REGION=auto
PHOTO_S3_BUCKET=
PHOTO_S3_ACCESS_KEY=
PHOTO_S3_SECRET_KEY=

# --- 로그인 세션 ---
SESSION_TIMEOUT=7d
