# 복사해서 .env 로 사용 (절대 커밋하지 말 것)
DB_NAME=daeppang
DB_USERNAME=daeppang
DB_PASSWORD=daeppang
DB_URL=jdbc:postgresql://localhost:5432/daeppang

# 카카오 (Kakao Developers)
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 (Naver Developers)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글 (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 공공데이터포털
DATA_GO_KR_SERVICE_KEY=

# Meta Graph API (Instagram) - 심사 전에는 비워두면 수집기가 비활성화됨
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
