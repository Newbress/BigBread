# 복사해서 .env 로 사용 (절대 커밋하지 말 것)
DB_NAME=bigbread
# 호스트 포트. Windows 등에서 로컬 PostgreSQL이 5432를 쓰고 있으면 5433 등으로 변경
DB_PORT=5432
DB_USERNAME=bigbread
DB_PASSWORD=bigbread
# DB_URL을 지정하면 DB_PORT/DB_NAME보다 우선한다 (보통은 비워둔다)
# DB_URL=

# 서비스 접속 주소. 소셜 로그인의 리다이렉트 URI 기준이다 (개발: 프론트 개발 서버, 배포: 운영 도메인)
# 제공자 콘솔에 등록할 리다이렉트 URI: {APP_BASE_URL}/login/oauth2/code/{kakao|naver|google}
APP_BASE_URL=http://localhost:5173
# HTTPS로 배포하면 true (세션 쿠키에 Secure 속성)
SESSION_COOKIE_SECURE=false
# 로그인 유지 기간 (세션 만료 + 쿠키 수명). 기본 7일
SESSION_TIMEOUT=7d
# 프록시(Nginx, ALB 등) 뒤에 둘 때만 framework (원래 접속자 IP를 요청 제한에 쓰려면 필요)
FORWARD_HEADERS_STRATEGY=none

# 카카오 (Kakao Developers) - 로그인 클라이언트 ID로 REST API 키를 쓴다
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 (Naver Developers)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글 (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 공공데이터포털
DATA_GO_KR_SERVICE_KEY=

# Meta Graph API (Instagram) - 심사 전에는 비워두면 수집기가 비활성화됨
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=

# --- 리뷰 사진 (선택) ---
# 업로드 사진을 저장할 폴더 (개발용, 기본 api/data/uploads)
# PHOTO_DIR=data/uploads
# HEIC(아이폰 사진)를 JPEG로 바꾸는 명령. {in}/{out}이 파일 경로가 된다.
# 윈도 + ImageMagick 예: PHOTO_HEIF_COMMAND=magick {in} -quality 92 {out}
# PHOTO_HEIF_COMMAND=heif-convert -q 92 {in} {out}
